    {
      "id": "7db27487-ddba-4281-b934-d6cec8cd2932",
      "name": "Sentinel activities",
      "description": {
        "content": "Sentinel activities are used to track and manage user authentication attempts, including successful and failed attempts. Based on your sentinel policy settings, Logto will automatically block users after a certain number of failed attempts. This helps to prevent unauthorized access and protect sensitive data. ",
        "type": "text/plain"
      },
