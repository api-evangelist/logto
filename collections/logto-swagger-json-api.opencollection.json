{
  "opencollection": "1.0.0",
  "info": {
    "name": "Logto API references Account center Swagger.json API",
    "version": "Cloud"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "/oidc/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Swagger.json",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Swagger JSON",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://[tenant_id].logto.app/api/swagger.json"
          },
          "docs": "The endpoint for the current JSON document. The JSON conforms to the [OpenAPI v3.0.1](https://spec.openapis.org/oas/v3.0.1) (a.k.a. Swagger) specification."
        }
      ]
    }
  ],
  "bundled": true
}