          "name": "Request and send a verification code",
          "request": {
            "name": "Request and send a verification code",
            "description": {
              "content": "Request a verification code for the provided identifier (email/phone).\nif you're using email as the identifier, you need to setup your email connector first.\nif you're using phone as the identifier, you need to setup your SMS connector first.",
