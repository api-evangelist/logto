{
  "opencollection": "1.0.0",
  "info": {
    "name": "Logto API references Account center User assets API",
    "version": "Cloud"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "/oidc/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "User assets",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get service status",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://[tenant_id].logto.app/api/user-assets/service-status"
          },
          "docs": "Get user assets service status."
        },
        {
          "info": {
            "name": "Upload asset",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://[tenant_id].logto.app/api/user-assets",
            "body": {
              "type": "multipart-form",
              "data": [
                {
                  "name": "file",
                  "type": "text",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Upload a user asset."
        }
      ]
    }
  ],
  "bundled": true
}