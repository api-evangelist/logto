{
  "opencollection": "1.0.0",
  "info": {
    "name": "Logto API references Account center API",
    "version": "Cloud"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "/oidc/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Account center",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get account center settings",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://[tenant_id].logto.app/api/account-center"
          },
          "docs": "Get the account center settings."
        },
        {
          "info": {
            "name": "Update account center settings",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://[tenant_id].logto.app/api/account-center",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update the account center settings with the provided settings."
        }
      ]
    }
  ],
  "bundled": true
}